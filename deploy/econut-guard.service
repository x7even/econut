[Unit]
Description=econut-guard: shut down when the UPS is on battery and low
After=nut-server.service
Wants=nut-server.service

[Service]
# Trigger level and debounce come from /etc/econut/econut.conf.
# Dry-run by default. Add --enable-shutdown only after the real-outage check.
EnvironmentFile=-/etc/econut/econut.conf
ExecStart=/usr/local/bin/econut-guard
# Creates /run/econut for the status file that `econut status` reads.
RuntimeDirectory=econut
RuntimeDirectoryMode=0755
Restart=on-failure
# Unprivileged throwaway user. For real shutdown replace this line with User=root
# (or a user permitted to run `systemctl poweroff`).
DynamicUser=yes

[Install]
WantedBy=multi-user.target
